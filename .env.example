# Copy to .env.local and fill in. Never commit real keys.
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
# (enable "Save payment methods" + "Transaction search" under Features)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A second sandbox *business* account that stands in for every retailer (receives Payouts)
RETAILER_PAYOUT_EMAIL=
# trychannel3.com (1000 free searches / month)
CHANNEL3_API_KEY=
# console.groq.com (primary model) and aistudio.google.com (fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
